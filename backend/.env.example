# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Example: mongodb://127.0.0.1:27017/uptimex or MongoDB Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/uptimex

# Client URL for CORS
CLIENT_ORIGIN=http://localhost:5173

# Authentication & Security
JWT_SECRET=your_jwt_secret_min_32_chars_placeholder
JWT_EXPIRES_IN=7d
COOKIE_NAME=uptimex_token
CSRF_COOKIE_NAME=uptimex_csrf
